# Supabase Auth (server-side only; do not prefix these with NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# RLS-scoped direct PostgreSQL connection used by @supabase/server.
# This is a database connection string, not a Supabase API key.
SUPABASE_DB_URL=

# Dedicated privileged role used only by migrations/provisioning later.
DATABASE_URL=
DIRECT_URL=
DIRECT_DATABASE_URL=

# Server-only. Do not add NEXT_PUBLIC_ and never expose it to Angular.
SUPABASE_SECRET_KEY=

# Comma-separated exact origins, for example:
# http://localhost:4200,https://app.example.com
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Used by tenant bootstrap scripts only. Never pass passwords/schema names as CLI args.
BOOTSTRAP_TENANT_ID=
BOOTSTRAP_USER_EMAIL=
BOOTSTRAP_USER_PASSWORD=
AUTH_USER_ID=
TENANT_ID=
TENANT_ROLE=owner
TENANT_RUT=
TENANT_NAME=
TENANT_SLUG=
TENANT_TIMEZONE=America/Santiago
TENANT_OWNER_USER_ID=
PROVISION_DRY_RUN=false

# Reserved for encrypted RUT/HMAC tenant CRUD
RUT_ENCRYPTION_KEY=
RUT_LOOKUP_KEY=
RUT_CURRENT_KEY_VERSION=1
